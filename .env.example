RCMCP_AGENT_HOST=127.0.0.1
RCMCP_AGENT_PORT=45231
RCMCP_AGENT_TOKEN=replace-me
RCMCP_DEVICES_FILE=./config/devices.local.json
RCMCP_HTTP_TIMEOUT_MS=120000
# MCP and agent request bodies are unbounded by default. If you impose a cap,
# set both values consistently for the controller and agents.
# RCMCP_MCP_MAX_BODY_BYTES=67108864
# RCMCP_BODY_LIMIT_BYTES=67108864

# Controller and agent tokens must be independently generated and stored privately.
RCMCP_MCP_HOST=127.0.0.1
RCMCP_MCP_PORT=45230
RCMCP_MCP_TOKEN=replace-me-controller
# RCMCP_STATE_DIR should be an absolute private path unique to each identity.
