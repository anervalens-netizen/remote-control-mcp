[Unit]
Description=Remote Control MCP device agent
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/work/remote-control-mcp
EnvironmentFile=%h/work/remote-control-mcp/.env.agent
Environment=RCMCP_RUNTIME_CONTEXT=user
ExecStart=/home/operator/.local/opt/node-v24.21.0-linux-x64/bin/node %h/work/remote-control-mcp/apps/agent/src/index.ts
Restart=always
RestartSec=2
KillMode=process

[Install]
WantedBy=default.target
